{
  "name": "swar_netra",
  "private": true,
  "version": "0.0.0",
  "description": "Eye-gaze communication board (AAC) that works with a normal laptop webcam",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strontium-rn/swar_netra.git"
  },
  "homepage": "https://github.com/strontium-rn/swar_netra#readme",
  "bugs": "https://github.com/strontium-rn/swar_netra/issues",
  "keywords": [
    "aac",
    "eye-tracking",
    "gaze",
    "accessibility",
    "autism",
    "webcam",
    "mediapipe"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "setup-mediapipe": "node scripts/copy-mediapipe.mjs",
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "tsc && tsc -p server && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "server": "node --experimental-strip-types server/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "uqr": "^0.1.2",
    "web-push": "^3.6.7"
  }
}
